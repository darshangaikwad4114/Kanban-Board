# Supabase project URL — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Browser-safe key. Use the publishable key (sb_publishable_…) for new projects.
# Legacy anon keys are supported via NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
# NEVER put a service_role / secret key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Public app origin used in auth confirmation and recovery redirects.
# Add <origin>/auth/callback to Supabase Auth → URL Configuration → Redirect URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
